{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {

		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": false,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,

		"strict": false,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": true,

	}
}
