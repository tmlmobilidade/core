{
	"name": "tmlmobilidade",
	"version": "1.0.0",
	"description": "",
	"author": "João de Vasconcelos & Jusi Monteiro",
	"license": "ISC",
	"keywords": [],
	"main": "index.js",
	"scripts": {
		"build": "turbo build",
		"build:core": "turbo build --filter=@tmlmobilidade/core",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"clean": "sh cleanup.sh",
		"test": "turbo test",
		"test:prod": "turbo test:prod"
	},
	"dependencies": {
		"@carrismetropolitana/eslint": "20250303.2009.45",
		"eslint": "9.22.0",
		"tsx": "4.19.3",
		"turbo": "2.4.4"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "npm@11.2.0",
	"peerDependencyRules": {
		"allowedVersions": {
			"react": "^18.x || ^19.x",
			"react-dom": "^18.x || ^19.x"
		},
		"ignoreMissing": [
			"react",
			"react-dom"
		]
	}
}
