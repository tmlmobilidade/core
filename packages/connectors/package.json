		"trino-client": "0.2.7",
		"tunnel-ssh": "5.2.0"
	},
	"devDependencies": {
		"@carrismetropolitana/eslint": "20250418.42.41",
		"@tmlmobilidade/tsconfig": "*",
		"@types/node": "24.0.1",
		"@types/pg": "8.15.4",
