{
	"extends": "@tmlmobilidade/tsconfig/next.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "dist",
		"paths": {
			"@/*": [
				"src/*"
			]
		},
		"rootDir": "."
	},
	"include": [
		"scripts/**/*.ts",
		"source.config.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		".next/types/**/*.ts",
		"content/**/*.tsx",
		"next-env.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
