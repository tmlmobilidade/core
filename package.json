{
	"name": "@tmlmobilidade/core",
	"description": "Core packages for Transportes Metropolitanos de Lisboa (TML) applications.",
	"version": "1.0.0",
	"author": "João de Vasconcelos & Jusi Monteiro",
	"license": "AGPL-3.0-or-later",
	"main": "index.js",
	"scripts": {
		"build": "turbo build",
		"build:connectors": "turbo build --filter=@tmlmobilidade/connectors",
		"build:create-tml-app": "turbo build --filter=create-tml-app",
		"build:emails": "turbo build --filter=@tmlmobilidade/emails",
		"build:generate-offer-files": "turbo build --filter=@tmlmobilidade/generate-offer-files",
		"build:interfaces": "turbo build --filter=@tmlmobilidade/interfaces",
		"build:lib": "turbo build --filter=@tmlmobilidade/lib",
		"build:packages": "turbo build --filter=./packages/*",
		"build:providers": "turbo build --filter=@tmlmobilidade/providers",
		"build:types": "turbo build --filter=@tmlmobilidade/types",
		"build:ui": "turbo build --filter=@tmlmobilidade/ui",
		"build:utils": "turbo build --filter=@tmlmobilidade/utils",
		"dev": "turbo dev",
		"dev:docs": "turbo dev --filter=@tmlmobilidade/docs",
		"dev:email": "turbo dev --filter=@tmlmobilidade/emails",
		"dev:ui": "turbo dev --filter=@tmlmobilidade/ui",
		"lint": "turbo lint",
		"rinse": "npx --yes @tmlmobilidade/repo-rinse",
		"test": "turbo test",
		"test:prod": "turbo test:prod",
		"yalc:push": "command -v yalc >/dev/null 2>&1 && sh scripts/yalc.sh || echo 'yalc not installed, skipping yalc push...'"
	},
	"devDependencies": {
		"@carrismetropolitana/eslint": "20250622.1204.50",
		"tsx": "4.20.3",
		"turbo": "2.5.4"
	},
	"workspaces": [
		"apps/*",
		"cli/*",
		"configs/*",
		"packages/*"
	],
	"packageManager": "npm@11.4.2",
	"peerDependencyRules": {
		"allowedVersions": {
			"react": "^18.x || ^19.x",
			"react-dom": "^18.x || ^19.x"
		},
		"ignoreMissing": [
			"react",
			"react-dom"
		]
	}
}
